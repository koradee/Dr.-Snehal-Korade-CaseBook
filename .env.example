# Dr. Snehal Korade CaseBook - Environment Variables

# Database Connection (PostgreSQL or Supabase connection string)
# e.g., postgresql://postgres:password@localhost:5432/casebook
DATABASE_URL=your_postgres_connection_string_here

# JWT Secret for Session Management
# e.g., run `openssl rand -base64 32` to generate a random string
JWT_SECRET=your_jwt_secret_here

# Supabase Storage Integration
# Create a Supabase project and get these from Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: Set admin password used by npm run db:seed
# ADMIN_PASSWORD=ChangeThisBeforeGoingLive123!
